<!-- single_drone.launch
     Launch all exploration nodes for ONE drone.
     Usage:  roslaunch uav_exploration_ros single_drone.launch drone_id:=0
-->
<launch>
  <arg name="drone_id"   default="0"/>
  <arg name="config"     default="$(find uav_exploration_ros)/config/exploration.yaml"/>

  <group ns="uav$(arg drone_id)">

    <!-- ===== Swarm Bridge (pose relay + waypoint recorder) ===== -->
    <node name="swarm_bridge" pkg="uav_exploration_ros" type="swarm_bridge_node.py"
          output="screen">
      <rosparam file="$(arg config)" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <remap from="swarm_bridge/pose_input_topic"
             to="mavros/local_position/pose"/>
    </node>

    <!-- ===== Depth Estimator ===== -->
    <node name="depth_estimator" pkg="uav_exploration_ros" type="depth_estimator_node.py"
          output="screen">
      <rosparam file="$(arg config)" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <remap from="depth_estimator/left/image_raw"
             to="stereo/left/image_raw"/>
      <remap from="depth_estimator/right/image_raw"
             to="stereo/right/image_raw"/>
      <remap from="depth_estimator/gt_depth"
             to="depth_camera/depth/image_raw"/>
    </node>

    <!-- ===== Grid Map ===== -->
    <node name="grid_map" pkg="uav_exploration_ros" type="grid_map_node.py"
          output="screen">
      <rosparam file="$(arg config)" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <remap from="grid_map/depth" to="depth_estimator/depth"/>
      <remap from="grid_map/pose"  to="swarm_bridge/pose"/>
    </node>

    <!-- ===== Frontier Explorer ===== -->
    <node name="frontier_explorer" pkg="uav_exploration_ros" type="frontier_node.py"
          output="screen">
      <rosparam file="$(arg config)" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <remap from="frontier_explorer/global_grid"
             to="grid_map/global_grid"/>
      <remap from="frontier_explorer/pose"
             to="swarm_bridge/pose"/>
    </node>

    <!-- ===== Planner ===== -->
    <node name="planner" pkg="uav_exploration_ros" type="planner_node.py"
          output="screen">
      <rosparam file="$(arg config)" command="load"/>
      <param name="drone_id" value="$(arg drone_id)"/>
      <remap from="planner/exploration_goal"
             to="frontier_explorer/exploration_goal"/>
      <remap from="planner/global_grid"
             to="grid_map/global_grid"/>
      <remap from="planner/pose"
             to="swarm_bridge/pose"/>
    </node>

  </group>
</launch>
