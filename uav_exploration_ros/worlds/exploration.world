          <material><ambient>0.6 0.35 0.25 1</ambient><diffuse>0.6 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>45.7 58.3 2.5 0 0 0</pose>
    </model>

    <model name="obs_4">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.9</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.9</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>25.6 82.4 2.5 0 0 0</pose>
    </model>

    <model name="obs_5">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3.5</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3.5</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>55.2 19.7 2.5 0 0 0</pose>
    </model>

    <model name="obs_6">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.1</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.1</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.25 1</ambient><diffuse>0.6 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>88.1 63.5 2.5 0 0 0</pose>
    </model>

    <model name="obs_7">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3.1</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3.1</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.5 0.3 0.2 1</ambient><diffuse>0.5 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>41.3 88.9 2.5 0 0 0</pose>
    </model>

    <model name="obs_8">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.7</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.7</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.55 0.3 0.25 1</ambient><diffuse>0.55 0.3 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>72.8 34.6 2.5 0 0 0</pose>
    </model>

    <model name="obs_9">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.6</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>1.6</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.6 0.35 0.2 1</ambient><diffuse>0.6 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>30.4 45.2 2.5 0 0 0</pose>
    </model>

    <model name="obs_10">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3.6</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3.6</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.5 0.35 0.25 1</ambient><diffuse>0.5 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>65.9 52.8 2.5 0 0 0</pose>
    </model>

    <model name="obs_11">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.3</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.3</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.55 0.35 0.25 1</ambient><diffuse>0.55 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>50.1 76.3 2.5 0 0 0</pose>
    </model>

  </world>
</sdf>
