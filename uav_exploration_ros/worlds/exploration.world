<?xml version="1.0" ?>
<!--
  exploration.world
  100 x 100 m area with cylinder obstacles for multi-UAV exploration.
  Obstacle layout matches uav_exploration sim_env (seed=42).
-->
<sdf version="1.6">
  <world name="exploration_world">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <!-- Lighting -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Ground plane (100 x 100 m) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.8 0.85 0.8 1</ambient>
            <diffuse>0.8 0.85 0.8 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>50 50 0 0 0 0</pose>
    </model>

    <!-- Boundary walls (height=5m, thickness=0.3m) -->
    <model name="wall_north">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>100 0.3 5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>100 0.3 5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>50 100 2.5 0 0 0</pose>
    </model>
    <model name="wall_south">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>100 0.3 5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>100 0.3 5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>50 0 2.5 0 0 0</pose>
    </model>
    <model name="wall_east">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 100 5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 100 5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>100 50 2.5 0 0 0</pose>
    </model>
    <model name="wall_west">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 100 5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 100 5</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient></material>
        </visual>
      </link>
      <pose>0 50 2.5 0 0 0</pose>
    </model>

    <!--
      Cylinder obstacles — generated from uav_exploration sim_env (seed=42).
      Each: center (x,y), radius r, height 5m.
    -->
    <model name="obs_0">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3.2</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3.2</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.6 0.3 0.2 1</ambient><diffuse>0.6 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>35.1 28.4 2.5 0 0 0</pose>
    </model>

    <model name="obs_1">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>2.5</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>2.5</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.5 0.35 0.25 1</ambient><diffuse>0.5 0.35 0.25 1</diffuse></material>
        </visual>
      </link>
      <pose>62.3 71.8 2.5 0 0 0</pose>
    </model>

    <model name="obs_2">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>3.8</radius><length>5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>3.8</radius><length>5</length></cylinder></geometry>
          <material><ambient>0.55 0.3 0.2 1</ambient><diffuse>0.55 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
      <pose>78.5 42.1 2.5 0 0 0</pose>
    </model>

    <model name="obs_3">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>1.8</radius><length>5</length></cylinder></geometry></collision>
